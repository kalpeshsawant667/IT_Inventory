CREATE TABLE roles (
    id BIGINT IDENTITY(1,1) PRIMARY KEY,
    name NVARCHAR(100) NOT NULL UNIQUE,
    description NVARCHAR(MAX),
    permissions_json NVARCHAR(MAX),
    created_at DATETIME2 NOT NULL DEFAULT SYSDATETIME()
);

CREATE TABLE locations (
    id BIGINT IDENTITY(1,1) PRIMARY KEY,
    name NVARCHAR(255) NOT NULL,
    type NVARCHAR(50) NOT NULL,
    parent_id BIGINT NULL,
    address NVARCHAR(MAX),
    created_at DATETIME2 NOT NULL DEFAULT SYSDATETIME(),

    CONSTRAINT FK_locations_parent
        FOREIGN KEY (parent_id) REFERENCES locations(id)
);

CREATE TABLE users (
    id BIGINT IDENTITY(1,1) PRIMARY KEY,
    email NVARCHAR(255) NOT NULL UNIQUE,
    password_hash NVARCHAR(MAX) NOT NULL,
    first_name NVARCHAR(100) NOT NULL,
    last_name NVARCHAR(100),
    phone NVARCHAR(30),
    role_id BIGINT NOT NULL,
    department_id BIGINT NULL,
    is_active BIT NOT NULL DEFAULT 1,
    created_at DATETIME2 NOT NULL DEFAULT SYSDATETIME(),
    updated_at DATETIME2 NOT NULL DEFAULT SYSDATETIME(),
    last_login DATETIME2 NULL,

    CONSTRAINT FK_users_roles
        FOREIGN KEY(role_id) REFERENCES roles(id),

    CONSTRAINT FK_users_locations
        FOREIGN KEY(department_id) REFERENCES locations(id)
);



CREATE TABLE vendors (
    id BIGINT IDENTITY(1,1) PRIMARY KEY,
    name NVARCHAR(255) NOT NULL,
    contact_person NVARCHAR(255),
    email NVARCHAR(255),
    phone NVARCHAR(30),
    address NVARCHAR(MAX),
    created_at DATETIME2 NOT NULL DEFAULT SYSDATETIME()
);



CREATE TABLE asset_categories (
    id BIGINT IDENTITY(1,1) PRIMARY KEY,
    name NVARCHAR(150) NOT NULL UNIQUE,
    parent_id BIGINT NULL,
    description NVARCHAR(MAX),
    created_at DATETIME2 NOT NULL DEFAULT SYSDATETIME(),

    CONSTRAINT FK_asset_categories_parent
        FOREIGN KEY(parent_id) REFERENCES asset_categories(id)
);



CREATE TABLE assets (
    id BIGINT IDENTITY(1,1) PRIMARY KEY,
    asset_tag NVARCHAR(100) NOT NULL UNIQUE,
    name NVARCHAR(255) NOT NULL,
    category_id BIGINT,
    model NVARCHAR(150),
    manufacturer NVARCHAR(150),
    serial_number NVARCHAR(255) UNIQUE,
    specifications_json NVARCHAR(MAX),
    purchase_date DATE,
    warranty_expiry DATE,
    purchase_cost DECIMAL(12,2),
    vendor_id BIGINT,
    status NVARCHAR(50) NOT NULL DEFAULT 'AVAILABLE',
    location_id BIGINT,
    assigned_to_user_id BIGINT,
    notes NVARCHAR(MAX),
    created_by BIGINT,
    created_at DATETIME2 NOT NULL DEFAULT SYSDATETIME(),
    updated_at DATETIME2 NOT NULL DEFAULT SYSDATETIME(),

    CONSTRAINT FK_assets_category
        FOREIGN KEY(category_id) REFERENCES asset_categories(id),

    CONSTRAINT FK_assets_vendor
        FOREIGN KEY(vendor_id) REFERENCES vendors(id),

    CONSTRAINT FK_assets_location
        FOREIGN KEY(location_id) REFERENCES locations(id),

    CONSTRAINT FK_assets_assigned_user
        FOREIGN KEY(assigned_to_user_id) REFERENCES users(id),

    CONSTRAINT FK_assets_created_by
        FOREIGN KEY(created_by) REFERENCES users(id)
);



CREATE TABLE asset_status_history (
    id BIGINT IDENTITY(1,1) PRIMARY KEY,
    asset_id BIGINT NOT NULL,
    old_status NVARCHAR(50),
    new_status NVARCHAR(50),
    changed_by BIGINT,
    reason NVARCHAR(MAX),
    created_at DATETIME2 NOT NULL DEFAULT SYSDATETIME(),

    CONSTRAINT FK_asset_status_asset
        FOREIGN KEY(asset_id) REFERENCES assets(id) ON DELETE CASCADE,

    CONSTRAINT FK_asset_status_user
        FOREIGN KEY(changed_by) REFERENCES users(id)
);



CREATE TABLE asset_assignments (
    id BIGINT IDENTITY(1,1) PRIMARY KEY,
    asset_id BIGINT NOT NULL,
    assigned_to_user_id BIGINT NOT NULL,
    assigned_by_user_id BIGINT,
    assigned_date DATE NOT NULL,
    expected_return_date DATE,
    actual_return_date DATE,
    status NVARCHAR(50) NOT NULL DEFAULT 'ASSIGNED',
    notes NVARCHAR(MAX),
    created_at DATETIME2 NOT NULL DEFAULT SYSDATETIME(),

    CONSTRAINT FK_assignment_asset
        FOREIGN KEY(asset_id) REFERENCES assets(id) ON DELETE CASCADE,

    CONSTRAINT FK_assignment_user
        FOREIGN KEY(assigned_to_user_id) REFERENCES users(id),

    CONSTRAINT FK_assignment_assignedby
        FOREIGN KEY(assigned_by_user_id) REFERENCES users(id)
);



CREATE TABLE maintenance_records (
    id BIGINT IDENTITY(1,1) PRIMARY KEY,
    asset_id BIGINT NOT NULL,
    maintenance_type NVARCHAR(100),
    description NVARCHAR(MAX),
    scheduled_date DATE,
    completed_date DATE,
    cost DECIMAL(12,2),
    performed_by NVARCHAR(255),
    status NVARCHAR(50),
    created_at DATETIME2 NOT NULL DEFAULT SYSDATETIME(),

    CONSTRAINT FK_maintenance_asset
        FOREIGN KEY(asset_id) REFERENCES assets(id) ON DELETE CASCADE
);



CREATE TABLE software (
    id BIGINT IDENTITY(1,1) PRIMARY KEY,
    name NVARCHAR(255) NOT NULL,
    publisher NVARCHAR(255),
    version NVARCHAR(100),
    license_type NVARCHAR(100),
    total_licenses INT DEFAULT 0,
    used_licenses INT DEFAULT 0,
    expiry_date DATE,
    created_at DATETIME2 NOT NULL DEFAULT SYSDATETIME()
);

CREATE TABLE asset_software (
    id BIGINT IDENTITY(1,1) PRIMARY KEY,
    asset_id BIGINT NOT NULL,
    software_id BIGINT NOT NULL,
    license_key_encrypted NVARCHAR(MAX),
    installed_date DATE,
    created_at DATETIME2 NOT NULL DEFAULT SYSDATETIME(),

    CONSTRAINT FK_assetsoftware_asset
        FOREIGN KEY(asset_id) REFERENCES assets(id) ON DELETE CASCADE,

    CONSTRAINT FK_assetsoftware_software
        FOREIGN KEY(software_id) REFERENCES software(id) ON DELETE CASCADE,

    CONSTRAINT UQ_asset_software
        UNIQUE(asset_id, software_id)
);


CREATE TABLE consumables (
    id BIGINT IDENTITY(1,1) PRIMARY KEY,
    name NVARCHAR(255) NOT NULL,
    category_id BIGINT,
    sku NVARCHAR(100) UNIQUE,
    quantity INT NOT NULL DEFAULT 0,
    reorder_level INT DEFAULT 0,
    unit_cost DECIMAL(12,2),
    location_id BIGINT,
    created_at DATETIME2 NOT NULL DEFAULT SYSDATETIME(),

    CONSTRAINT FK_consumables_category
        FOREIGN KEY(category_id) REFERENCES asset_categories(id),

    CONSTRAINT FK_consumables_location
        FOREIGN KEY(location_id) REFERENCES locations(id)
);

CREATE TABLE consumable_transactions (
    id BIGINT IDENTITY(1,1) PRIMARY KEY,
    consumable_id BIGINT NOT NULL,
    transaction_type NVARCHAR(30) NOT NULL,
    quantity INT NOT NULL,
    reference_type NVARCHAR(100),
    reference_id BIGINT,
    performed_by BIGINT,
    created_at DATETIME2 NOT NULL DEFAULT SYSDATETIME(),

    CONSTRAINT FK_consumable_txn
        FOREIGN KEY(consumable_id) REFERENCES consumables(id) ON DELETE CASCADE,

    CONSTRAINT FK_consumable_user
        FOREIGN KEY(performed_by) REFERENCES users(id)
);


CREATE TABLE audit_logs (
    id BIGINT IDENTITY(1,1) PRIMARY KEY,
    table_name NVARCHAR(100) NOT NULL,
    record_id BIGINT NOT NULL,
    action NVARCHAR(30) NOT NULL,
    old_values_json NVARCHAR(MAX),
    new_values_json NVARCHAR(MAX),
    performed_by BIGINT,
    ip_address NVARCHAR(45),
    created_at DATETIME2 NOT NULL DEFAULT SYSDATETIME(),

    CONSTRAINT FK_audit_user
        FOREIGN KEY(performed_by) REFERENCES users(id)
);



CREATE INDEX IX_users_email
ON users(email);

CREATE INDEX IX_assets_asset_tag
ON assets(asset_tag);

CREATE INDEX IX_assets_serial
ON assets(serial_number);

CREATE INDEX IX_assets_status
ON assets(status);

CREATE INDEX IX_assets_location
ON assets(location_id);

CREATE INDEX IX_assets_assigned_user
ON assets(assigned_to_user_id);

CREATE INDEX IX_asset_assignments_asset
ON asset_assignments(asset_id);

CREATE INDEX IX_asset_assignments_user
ON asset_assignments(assigned_to_user_id);

CREATE INDEX IX_asset_status_history_asset
ON asset_status_history(asset_id);

CREATE INDEX IX_maintenance_asset
ON maintenance_records(asset_id);

CREATE INDEX IX_asset_software_asset
ON asset_software(asset_id);

CREATE INDEX IX_consumable_transactions
ON consumable_transactions(consumable_id);

CREATE INDEX IX_audit_logs
ON audit_logs(table_name, record_id);

CREATE INDEX IX_locations_parent
ON locations(parent_id);

CREATE INDEX IX_asset_categories_parent
ON asset_categories(parent_id);


ALTER TABLE assets
ADD CONSTRAINT CK_assets_status
CHECK (status IN (
    'AVAILABLE',
    'ASSIGNED',
    'IN_REPAIR',
    'IN_MAINTENANCE',
    'RETIRED',
    'LOST',
    'DISPOSED'
));

ALTER TABLE asset_assignments
ADD CONSTRAINT CK_assignment_status
CHECK (status IN (
    'ASSIGNED',
    'RETURNED',
    'OVERDUE'
));

ALTER TABLE consumable_transactions
ADD CONSTRAINT CK_transaction_type
CHECK (transaction_type IN (
    'IN',
    'OUT',
    'ADJUSTMENT'
));