CREATE DATABASE IT_Inventory;
USE IT_Inventory;

CREATE TABLE users (
    user_id INT PRIMARY KEY,
    employee_id VARCHAR(20) UNIQUE,
    first_name VARCHAR(50),
    last_name VARCHAR(50),
    email VARCHAR(100) UNIQUE,
    phone VARCHAR(15),
    department VARCHAR(50),
    designation VARCHAR(50),
    location VARCHAR(100),
    status VARCHAR(10) NOT NULL
        CONSTRAINT CK_users_status CHECK (status IN ('Active', 'Inactive'))
        DEFAULT 'Active',
    created_at DATETIME DEFAULT GETDATE()
);

CREATE TABLE asset_categories (
    category_id INT NOT NULL PRIMARY KEY,
    category_name VARCHAR(100) UNIQUE NOT NULL
);

CREATE TABLE vendors (
    vendor_id INT PRIMARY KEY,
    vendor_name VARCHAR(100),
    contact_person VARCHAR(100),
    email VARCHAR(100),
    phone VARCHAR(20),
    address TEXT
);

CREATE TABLE locations (
    location_id INT PRIMARY KEY,
    location_name VARCHAR(100),
    city VARCHAR(50),
    state VARCHAR(50)
);

CREATE TABLE assets
(
    asset_id INT IDENTITY(1,1) PRIMARY KEY,

    asset_tag NVARCHAR(30) NOT NULL UNIQUE,
    serial_number NVARCHAR(100) UNIQUE,

    category_id INT NOT NULL,
    vendor_id INT NULL,
    location_id INT NULL,

    brand NVARCHAR(50),
    model NVARCHAR(100),
    processor NVARCHAR(100),
    ram NVARCHAR(50),
    storage NVARCHAR(50),

    purchase_date DATE DEFAULT GETDATE(),
    warranty_expiry DATE,
    purchase_cost DECIMAL(10,2),

    asset_status NVARCHAR(20)
        CONSTRAINT CK_assets_status
        CHECK (asset_status IN ('Available','Assigned','Repair','Scrapped'))
        DEFAULT 'Available',

    remarks NVARCHAR(MAX),

    created_at DATETIME2 DEFAULT SYSDATETIME(),
    updated_at DATETIME2 DEFAULT SYSDATETIME(),

    CONSTRAINT FK_assets_category
        FOREIGN KEY(category_id)
        REFERENCES asset_categories(category_id),

    CONSTRAINT FK_assets_vendor
        FOREIGN KEY(vendor_id)
        REFERENCES vendors(vendor_id),

    CONSTRAINT FK_assets_location
        FOREIGN KEY(location_id)
        REFERENCES locations(location_id)
);

CREATE TABLE asset_assignments (

    assignment_id INT PRIMARY KEY,

    asset_id INT NOT NULL,
    user_id INT NOT NULL,

    assigned_date DATE,
    expected_return DATE,
    returned_date DATE,

    assignment_status VARCHAR(20) NOT NULL
        CONSTRAINT CK_asset_assignments_status
        CHECK (assignment_status IN ('Assigned', 'Returned'))
        DEFAULT 'Assigned',

    remarks VARCHAR(MAX),

    CONSTRAINT FK_asset_assignments_asset
        FOREIGN KEY (asset_id)
        REFERENCES assets(asset_id),

    CONSTRAINT FK_asset_assignments_user
        FOREIGN KEY (user_id)
        REFERENCES users(user_id)
);

CREATE TABLE maintenance (

    maintenance_id INT PRIMARY KEY,

    asset_id INT,

    issue_description VARCHAR(MAX),

    vendor_name VARCHAR(100),

    service_date DATE,

    service_cost DECIMAL(10,2),

    status VARCHAR(20) NOT NULL
        CONSTRAINT CK_maintenance_status
        CHECK (status IN ('Open', 'In Progress', 'Completed')),

    remarks VARCHAR(MAX),

    CONSTRAINT FK_maintenance_asset
        FOREIGN KEY (asset_id)
        REFERENCES assets(asset_id)
);

CREATE TABLE software_licenses (

    license_id INT PRIMARY KEY,

    software_name VARCHAR(100),

    license_key VARCHAR(255),

    purchased_quantity INT,

    assigned_quantity INT,

    expiry_date DATE,

    vendor VARCHAR(100)
);

CREATE TABLE asset_history (

    history_id INT PRIMARY KEY,

    asset_id INT,

    action_taken VARCHAR(100),

    action_date DATETIME2
        DEFAULT SYSDATETIME(),

    performed_by VARCHAR(100),

    remarks VARCHAR(MAX),

    CONSTRAINT FK_asset_history_asset
        FOREIGN KEY (asset_id)
        REFERENCES assets(asset_id)
);


